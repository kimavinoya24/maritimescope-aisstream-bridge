PORT=10000
AIS_PROVIDER=pelyr
PELYR_API_KEY=
BRIDGE_TOKEN=
GLOBAL_STREAM=true
AIS_BOXES=[[[5,115],[10,120]]]
ALLOW_GLOBAL_BOXES=true
MAX_CACHE=15000
# Static-name subscriptions rotate across the live working set.
STATIC_REFRESH_MS=60000
# AIS vessel data is memory-only on Render; do not configure MySQL ingestion.

# Pelyr OPEN-AIS
PELYR_START_DELAY_MS=5000
PELYR_429_COOLDOWN_MS=120000
PELYR_API_REFRESH_MS=0
