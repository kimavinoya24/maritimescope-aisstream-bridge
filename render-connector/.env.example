# Open Waters aiscast is the default provider. Set AIS_PROVIDER=aisstream only if you want the old provider.
AIS_PROVIDER=openwaters
# Optional: Open Waters personal token. Anonymous v1 access works for small boxes.
OPENWATERS_API_KEY=
# For AISStream fallback mode only:
AISSTREAM_API_KEY=
BRIDGE_TOKEN=
APP_URL=
AIS_INGEST_KEY=
AIS_INGEST_PATH=/vessel-sync.php
AIS_BOXES=[[[5,115],[10,120]]]
ALLOW_GLOBAL_BOXES=false
MAX_CACHE=5000
AIS_INGEST_BATCH_SIZE=20
AIS_INGEST_INTERVAL_MS=5000
AIS_INGEST_RETRIES=3
AIS_INGEST_RETRY_DELAY_MS=2500
AIS_INGEST_DEBUG=true
AIS_PUSH_INGEST=false
