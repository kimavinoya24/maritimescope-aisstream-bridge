AISSTREAM_API_KEY=your_aisstream_key
BRIDGE_TOKEN=your_private_bridge_token
APP_URL=https://your-infinityfree-site.example
AIS_INGEST_KEY=your_private_ingest_key
AIS_INGEST_PATH=/aisfeed.php
# Start small. Expand after /health reports aisConnected=true and messages > 0.
AIS_BOXES=[[[0,100],[30,150]]]
MAX_CACHE=10000
